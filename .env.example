# --- Local dev (recommended) ---
# Leave VITE_API_BASE_URL unset: the app uses same-origin requests; vite.config.js
# proxies /api and /health to the Nest server. Override if needed:
# VITE_PROXY_TARGET=http://127.0.0.1:5000

# --- Call API directly from the browser (optional) ---
# If set, the proxy is skipped for API calls. Backend must allow CORS from the Vite origin.
# VITE_API_BASE_URL=http://127.0.0.1:5000
